 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggfinalfn     | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggfinalmodify | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggfnoid       | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | agginitval     | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggkind        | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggmfinalextra | SELECT
 dn      | PUBLIC  | pg_catalog   | pg_aggregate | aggmfinalfn    | SELECT
(10 rows)

