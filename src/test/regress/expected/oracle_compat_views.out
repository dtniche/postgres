    data_type,
    is_nullable
FROM information_schema.columns
WHERE table_name = 'dba_tables'
    AND column_name IN (
        'pct_free',
        'num_rows',
        'blocks',
        'last_analyzed'
    )
ORDER BY ordinal_position;
