    (SELECT COUNT(*) FROM information_schema.columns WHERE table_name = 'all_tables') as all_tables_cols,
    (SELECT COUNT(*) FROM information_schema.columns WHERE table_name = 'user_tables') as user_tables_cols,
    (SELECT COUNT(*) FROM information_schema.columns WHERE table_name = 'dba_all_tables') as dba_all_tables_cols,
    (SELECT COUNT(*) FROM information_schema.columns WHERE table_name = 'all_all_tables') as all_all_tables_cols,
    (SELECT COUNT(*) FROM information_schema.columns WHERE table_name = 'user_all_tables') as user_all_tables_cols;
